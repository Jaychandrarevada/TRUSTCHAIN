# ──────────────────────────────────────────────────────────────────────────────
# TrustChain Deployment Environment Configuration
# Copy this file to `.env` before running: docker compose up -d --build
# ──────────────────────────────────────────────────────────────────────────────

# ── Database Configuration (PostgreSQL 16) ───────────────────────────────────
POSTGRES_USER=trustchain
POSTGRES_PASSWORD=trustchain_secure_password
POSTGRES_DB=trustchain

# ── Backend Security Secrets (Replace with random strings for production) ───
SECRET_KEY=college-demo-trustchain-secret-key-2026-secure
JWT_SECRET_KEY=college-demo-trustchain-jwt-secret-key-2026-secure

# ── Blockchain Configuration ────────────────────────────────────────────────
# Use 'mock' for local college room demonstration (zero gas fees, instant anchoring)
# Use 'web3' for live testnet deployment (requires RPC_URL and private key)
BLOCKCHAIN_MODE=mock
CHAIN_ID=137
RPC_URL=https://polygon-rpc.com

# ── Optional Claude AI Assistant Key ─────────────────────────────────────────
# Advisory-only student assistant. Leave blank to run without external AI dependency.
ANTHROPIC_API_KEY=

# ── Exposed Ports ────────────────────────────────────────────────────────────
# Frontend web portal URL: http://localhost:3000
FRONTEND_PORT=3000
# Backend API & Swagger documentation URL: http://localhost:5000/api/v1/docs
BACKEND_PORT=5000
