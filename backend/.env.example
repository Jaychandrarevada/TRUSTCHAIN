# ──────────────────────────────────────────────────────────────────────────────
# TrustChain backend — environment template. Copy to `.env`; NEVER commit `.env`.
# Production: secrets come from AWS Secrets Manager / KMS, not files (SRS SEC-05).
# ──────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development                  # development | testing | production
SECRET_KEY=change-me-64-random-bytes
API_BASE_URL=http://localhost:5000
VERIFY_BASE_URL=http://localhost:3000  # public verification web app

# Database (PostgreSQL in dev/prod; tests use in-memory SQLite automatically)
DATABASE_URL=postgresql+psycopg2://trustchain:trustchain@localhost:5432/trustchain

# JWT (RS256 in production — provide key paths; HS256 fallback for local dev)
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Rate limiting / cache
REDIS_URL=redis://localhost:6379/0

# Blockchain (mirrors blockchain/.env.example)
BLOCKCHAIN_MODE=mock                   # mock | web3   (mock = no chain required)
CHAIN_ID=80002                         # 80002 Amoy | 11155111 Sepolia | 137 Polygon
RPC_URL=https://rpc-amoy.polygon.technology
RELAYER_PRIVATE_KEY=                   # dev/testnet ONLY — production signs via KMS
ISSUER_REGISTRY_ADDRESS=
CERTIFICATE_ANCHOR_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
ANCHOR_CONFIRMATIONS=16

# Email (mock logs to console in dev)
MAIL_MODE=mock                         # mock | smtp
MAIL_FROM=no-reply@trustchain.local

# CORS — comma-separated allowed origins (web apps)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
