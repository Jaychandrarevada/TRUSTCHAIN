# TrustChain frontend — environment template (Vite exposes VITE_* only)
# API base; dev uses the Vite proxy (/api → localhost:5000), so keep as-is locally.
VITE_API_BASE_URL=/api/v1
# Expected chain for wallet features (80002 Amoy | 11155111 Sepolia | 137 Polygon)
VITE_CHAIN_ID=80002
# Public verification origin printed in QR codes / share links
VITE_VERIFY_BASE_URL=http://localhost:3000
