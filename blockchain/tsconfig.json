{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true
  },
  "include": ["hardhat.config.ts", "scripts/**/*", "test/**/*", "integration/**/*", "config/**/*", "utils/**/*", "typechain-types/**/*"],
  "exclude": ["node_modules", "dist"]
}
