# ──────────────────────────────────────────────────────────────────────────────
# TrustChain blockchain layer — environment template
# Copy to `.env` and fill in. NEVER commit `.env`. In production the relayer
# and registrar sign via AWS KMS (TDD SEC-KEY-1/2); raw private keys are for
# testnets and local development ONLY.
# ──────────────────────────────────────────────────────────────────────────────

# ── RPC endpoints ─────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Signing (testnet/dev only — production uses KMS) ─────────────────────────
DEPLOYER_PRIVATE_KEY=

# ── Explorer verification ────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# ── Governance addresses used by scripts/deploy.ts ───────────────────────────
# 3-of-5 Gnosis Safe (DEFAULT_ADMIN + UPGRADER via 48h timelock in production).
# On testnets these may be the deployer address.
GOVERNANCE_SAFE_ADDRESS=
# TimelockController address (deployed separately in production; empty = skip).
TIMELOCK_ADDRESS=
# Hot service keys (KMS-backed in production).
REGISTRAR_SERVICE_ADDRESS=
ANCHORER_SERVICE_ADDRESS=
PAUSER_ADDRESS=

# ── Gas reporting ─────────────────────────────────────────────────────────────
REPORT_GAS=false
COINMARKETCAP_API_KEY=

# ── IPFS / Pinata (integration/ipfs) ─────────────────────────────────────────
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
